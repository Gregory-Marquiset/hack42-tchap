# Fragment a AJOUTER au Caddyfile de caddy-01 (VM 105, /home/greg/caddy/Caddyfile).
# Ne pas remplacer le fichier : il sert deja d autres sites en production.
#
# Deployer :
#   cp Caddyfile Caddyfile.bak-$(date +%F-%H%M)
#   cat fragment >> Caddyfile
#   docker exec caddy caddy validate --config /etc/caddy/Caddyfile
#   docker exec caddy caddy reload   --config /etc/caddy/Caddyfile
#
# Le hash est volontairement absent de ce depot public. Le generer avec :
#   docker exec caddy caddy hash-password

# AUTHENTIFICATION SUR LES DEUX, y compris la prod : config.json pointe pour
# l'instant sur le vrai homeserver de l'Etat (matrix.agent.tchap.gouv.fr). Une
# page de login aux couleurs de Tchap, en libre acces sur un domaine duckdns et
# branchee sur le service reel, serait indiscernable d'un site de phishing.
# A retirer le jour ou config.json pointera sur notre propre homeserver de test.
(hack42_auth) {
    basic_auth {
        hack42 REMPLACER_PAR_LE_HASH
    }
    header X-Robots-Tag "noindex, nofollow"
    encode zstd gzip
}

hack-prod.duckdns.org {
    import hack42_auth
    reverse_proxy 192.168.1.130:8080
}

hack-staging.duckdns.org {
    import hack42_auth
    header X-Environment staging
    reverse_proxy 192.168.1.131:8080
}
