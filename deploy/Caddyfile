# A poser sur caddy-01 (VM 105). Certificats via HTTP-01 : les ports 80 et 443
# de la bbox sont deja rediriges vers caddy-01, donc ca marche tel quel.
#
# Tant que tu regles la conf, decommente cette ligne pour ne pas cramer les
# quotas Let s Encrypt (les certificats seront invalides dans le navigateur,
# c est normal) :
# {
# 	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
# }

(commun) {
	encode zstd gzip
	log {
		output file /var/log/caddy/{args[0]}.log
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

hack-prod.duckdns.org {
	import commun prod
	reverse_proxy 192.168.1.130:8080
}

hack-staging.duckdns.org {
	import commun staging

	# Staging joignable mais ni indexe ni ouvert a tout le monde.
	header X-Robots-Tag "noindex, nofollow"
	header X-Environment staging
	basicauth {
		# Generer le hash avec : docker run --rm caddy caddy hash-password
		hack42 $2a$14$REMPLACER_PAR_LE_HASH
	}

	reverse_proxy 192.168.1.131:8080
}
